        },
        "highlight": {
            "effect": "breathing",
            "color": "#E95420",
            "secondaryColor": "#FFB000"
        }
    },
    "background": {
        "blur": 0.08,
        "url": "https://raw.githubusercontent.com/SharkyA7/Discord-custom-theme/main/2059357949559005222.jpg",
        "alpha": 0.15
    },
    "animations": {
        "hover": {
            "card": "float",
            "button": "pulse"
        },
        "click": {
            "button": "ripple"
        },
        "breathing": {
            "enabled": true,
            "color": "#E95420",
            "secondaryColor": "#FFB000",
            "speed": 4,
            "intensity": 0.4
        }
    },
    "typography": {
        "fontPrimary": "'Ubuntu Mono', 'JetBrains Mono', 'Fira Code', monospace",
        "fontSecondary": "'Ubuntu', 'Inter', 'SF Pro Display', sans-serif",
        "sizeNormal": "14px",
        "sizeLarge": "16px",
        "sizeSmall": "12px",
        "textShadow": "0px 0px 6px rgba(233, 84, 32, 0.4)"
    },
    "shadows": {
        "card": "0px 4px 16px rgba(0, 0, 0, 0.7), 0px 0px 2px rgba(233, 84, 32, 0.15)",
        "button": "0px 2px 8px rgba(0, 0, 0, 0.6), 0px 0px 1px rgba(233, 84, 32, 0.2)"
    },
    "spec": 2
}